{
  "enabled": true,
  "name": "Run Vitest on Domain Changes",
  "description": "Automatically executes unit tests whenever domain logic or TypeScript sources are updated.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/domain/**/*.ts",
      "src/audio/**/*.ts"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm test -- --run"
  }
}
